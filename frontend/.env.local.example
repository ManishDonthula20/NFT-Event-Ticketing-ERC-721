VITE_PINATA_JWT=your_VITE_PINATA_JWT_key

# Optional: a dedicated Pinata gateway subdomain (higher rate limits and
# generally faster than the shared gateway.pinata.cloud). Leave blank to
# use the shared gateway. Example:
#   VITE_PINATA_GATEWAY=https://<your-subdomain>.mypinata.cloud/ipfs/
VITE_PINATA_GATEWAY=your_VITE_PINATA_GATEWAY_url

# Optional: a local Kubo HTTP gateway. ONLY relevant if you're pinning
# content to your own IPFS node INSTEAD of Pinata. When VITE_PINATA_JWT
# is set (as above) the app pins to Pinata and reads from Pinata, and
# this setting is ignored — leave it blank or commented out.
# VITE_IPFS_GATEWAY=http://127.0.0.1:8080/ipfs/